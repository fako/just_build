# Example supervisor configuration for a project
# Copy this file and replace the placeholders:
#   PROJECT_NAME  - e.g., myapp
#   PROJECT_PORT  - e.g., 8001 (unique per project)
#   ASGI_MODULE   - e.g., web.asgi (Django) or main:app (FastAPI)
#   DJANGO_MODULE - e.g., web

[program:PROJECT_NAME]
command=/home/PROJECT_NAME/venv/bin/python -m uvicorn ASGI_MODULE:application --host 127.0.0.1 --port PROJECT_PORT --workers 2 --loop uvloop --http httptools
directory=/home/PROJECT_NAME
user=PROJECT_NAME
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/var/log/projects/PROJECT_NAME.log
stdout_logfile_maxbytes=50MB
stdout_logfile_backups=5
environment=
    DJANGO_SETTINGS_MODULE="DJANGO_MODULE.settings",
    PYTHONPATH="/home/PROJECT_NAME"
