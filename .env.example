# Terminal environment
# Use "workspaces" for the full stack, "control" to leave out the agent workspaces, or "services" to
# run management as a development server on the host instead of in its container.
COMPOSE_PROFILES=workspaces

# CLI environment
INVOKE_POSTGRES_PASSWORD=qwerty
# Password management uses to reach supervisord in the workspaces container over XML-RPC.
INVOKE_WORKSPACES_SUPERVISOR_PASSWORD=qwerty

# Management environment
INVOKE_MANAGEMENT_SECURITY_DEBUG=1
INVOKE_MANAGEMENT_SECURITY_SECRET_KEY=
# The control API key used by the invoke CLI. Replace the placeholder UUID with your own; without a
# matching key management rejects every CLI call. Workspaces get their own keys when they are created.
INVOKE_MANAGEMENT_SECURITY_API_KEY=control:00000000-0000-0000-0000-000000000000
INVOKE_MANAGEMENT_DATABASE_NAME=management
INVOKE_MANAGEMENT_DATABASE_USER=management
INVOKE_MANAGEMENT_DATABASE_PASSWORD=qwerty
