# Rendered by services/backups/install.sh. Edit the template, then rerun invoke install.backups.
[Unit]
Description=Just Build database backups
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# The installing user: it owns the backups, reaches the Docker socket, and its ~/.ssh/config holds
# the aliases remotes are registered under.
User=@USER@
WorkingDirectory=@REPOSITORY@
# The same values activate.sh loads. The generated secrets are alphanumeric, so systemd parses the
# file the way the shell does.
EnvironmentFile=@REPOSITORY@/.env
ExecStart=@REPOSITORY@/venv/bin/invoke backups.run
Nice=10
IOSchedulingClass=idle
