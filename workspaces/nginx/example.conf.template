# Example nginx configuration for a project
# Copy this file and replace the placeholders:
#   PROJECT_NAME   - e.g., myapp
#   PROJECT_DOMAIN - e.g., myapp.localhost
#   PROJECT_PORT   - e.g., 8001 (must match supervisor config)

upstream PROJECT_NAME_upstream {
    server 127.0.0.1:PROJECT_PORT fail_timeout=0;
}

server {
    listen 7000;
    server_name PROJECT_DOMAIN;

    client_max_body_size 100M;

    location /static/ {
        alias /home/PROJECT_NAME/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /media/ {
        alias /home/PROJECT_NAME/media/;
        expires 7d;
    }

    location / {
        proxy_pass http://PROJECT_NAME_upstream;
        proxy_http_version 1.1;
        
        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
