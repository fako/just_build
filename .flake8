[flake8]
# Match the repository guidance in `.cursorrules`.
max-line-length = 120
inline-quotes = double
multiline-quotes = double
docstring-quotes = double
avoid-escape = True
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    */migrations/*,
    # Agent-owned workspace repositories and vendored template payloads. Not ours to lint.
    workspaces/src,
    workspaces/templates/datagrowth,
    # Jinja sources, which only become valid Python once rendered into a workspace.
    *.tpl.py
