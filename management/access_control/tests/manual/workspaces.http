@baseUrl = http://127.0.0.1:8000
@workspaceSlug = acme
# The control key from .env (INVOKE_MANAGEMENT_SECURITY_API_KEY).
@controlKey = control:00000000-0000-0000-0000-000000000000
# A workspace key, as returned once by the create or rotate-key calls below.
@workspaceKey = workspace:00000000-0000-0000-0000-000000000000

### Create a workspace, which returns its API key exactly once
POST {{baseUrl}}/api/v1/workspaces/
Authorization: Bearer {{controlKey}}
Content-Type: application/json

{
  "name": "Acme",
  "module": "acme",
  "django_module": "web"
}

### List workspaces
GET {{baseUrl}}/api/v1/workspaces/
Authorization: Bearer {{controlKey}}

### List workspaces as a workspace, which only ever returns itself
GET {{baseUrl}}/api/v1/workspaces/
Authorization: Bearer {{workspaceKey}}

### Get one workspace
GET {{baseUrl}}/api/v1/workspaces/{{workspaceSlug}}/
Authorization: Bearer {{controlKey}}

### Patch workspace setup and SSH metadata
PATCH {{baseUrl}}/api/v1/workspaces/{{workspaceSlug}}/
Authorization: Bearer {{controlKey}}
Content-Type: application/json

{
  "setup": {
    "ssh_access": "2026-03-25T11:00:00Z"
  },
  "ssh": {
    "alias": "acme-workspace",
    "user": "acme",
    "host": "localhost",
    "port": 2222,
    "identity_file": "workspaces/src/ssh/acme/id_ed25519"
  }
}

### Rotate a workspace API key, retiring the previous one
POST {{baseUrl}}/api/v1/workspaces/{{workspaceSlug}}/rotate-key/
Authorization: Bearer {{controlKey}}

### Render aggregate SSH config
GET {{baseUrl}}/api/v1/workspaces/ssh-config/
Authorization: Bearer {{controlKey}}

### Anonymous calls are rejected
GET {{baseUrl}}/api/v1/workspaces/
