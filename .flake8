[flake8]
# Match the repository guidance in `.cursorrules`.
max-line-length = 120
inline-quotes = double
multiline-quotes = double
docstring-quotes = double
avoid-escape = True
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    */migrations/*,
    # Agent-owned workspace repositories. Their code is not ours to lint.
    workspaces/src
